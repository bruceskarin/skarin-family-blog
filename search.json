[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":"{{ post.url | relative_url }}","date":"{{ post.date | date: "%Y-%m-%d" }}","text":{{ post.content | strip_html | strip_newlines | truncate: 600 | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
